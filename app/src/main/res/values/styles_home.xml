<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CardStockFlow" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="NavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimary</item>
    </style>

    <!-- Barra inferior compartida por todas las pantallas -->
    <style name="BarraInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="itemActiveIndicatorStyle">@style/NavActiveIndicator</item>
        <item name="itemIconTint">@color/nav_icon_color</item>
        <item name="itemTextColor">@color/nav_text_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

</resources>
