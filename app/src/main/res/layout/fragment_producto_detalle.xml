<?xml version="1.0" encoding="utf-8"?>
<!--
  PLACEHOLDER de la pantalla "Detalle del Producto": reemplazar TODO este contenido por el diseño de Figma.
  - Aquí va solo el contenido de la pantalla. La barra inferior NO se incluye: vive en
    activity_main.xml y se ve en todas las pantallas.
  - Textos en res/values/strings.xml (@string/...), no escritos aquí.
  - Colores del tema (?attr/colorSurface, ?attr/colorOnSurface, ?attr/colorOnSurfaceVariant,
    ?attr/colorPrimary...) para que el modo oscuro funcione.
  - Lo que ya existe y se puede reutilizar: item_movimiento.xml (fila de lista), el estilo
    @style/CardStockFlow (tarjeta) y los drawables bg_badge_entrada / bg_badge_salida.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/title_product_detail" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainer"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/under_construction"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Editar producto (temporal)"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMovimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Registrar movimiento (temporal)"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</LinearLayout>
